<!--
  Installeur MSI du host Creamote (WiX 5).
    wix build packaging/windows/host.wxs -arch x64 -d Version=0.2.0 \
      -d HostExe=target/release/creamote-host.exe -o creamote-host.msi

  Installe le binaire dans « Program Files\Creamote Host » et le service
  CreamoteHost (SYSTEM, démarrage automatique), qui lance le host dans la
  session affichée à l'écran. La configuration est lue dans
  %ProgramData%\Creamote\host.conf.

  Déploiement de masse : les propriétés publiques écrivent host.conf avant
  le démarrage du service (une propriété vide ne change rien) :
    msiexec /i creamote-host.msi /qn SERVER=relay.example.org:21400 ^
      SERVER_PIN=<empreinte> ENROLL_TOKEN=<jeton> [HOST_NAME=<nom>] ^
      [RELAY_ONLY=true] [AUTO_UPDATE=false]
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Creamote Host"
           Manufacturer="Creamote"
           Version="$(var.Version)"
           UpgradeCode="A20FEAB4-673E-42D7-BCA0-36708570890C"
           Scope="perMachine"
           Compressed="yes">
    <SummaryInformation Description="Creamote Host : accès à distance sans surveillance" />
    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de Creamote Host est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="SERVER" Secure="yes" />
    <Property Id="SERVER_PIN" Secure="yes" />
    <!-- Masqué dans les journaux d'installation. -->
    <Property Id="ENROLL_TOKEN" Secure="yes" Hidden="yes" />
    <Property Id="HOST_NAME" Secure="yes" />
    <Property Id="RELAY_ONLY" Secure="yes" />
    <Property Id="AUTO_UPDATE" Secure="yes" />

    <!-- Exécutée sous SYSTEM, après la copie des fichiers et avant le
         démarrage du service. -->
    <CustomAction Id="WriteHostConf"
                  FileRef="HostExe"
                  ExeCommand="configure --server &quot;[SERVER]&quot; --server-pin &quot;[SERVER_PIN]&quot; --enroll-token &quot;[ENROLL_TOKEN]&quot; --name &quot;[HOST_NAME]&quot; --relay-only &quot;[RELAY_ONLY]&quot; --auto-update &quot;[AUTO_UPDATE]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  HideTarget="yes"
                  Return="check" />
    <InstallExecuteSequence>
      <Custom Action="WriteHostConf" Before="StartServices"
              Condition="NOT REMOVE AND (SERVER OR SERVER_PIN OR ENROLL_TOKEN OR HOST_NAME OR RELAY_ONLY OR AUTO_UPDATE)" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Creamote Host">
        <Component Id="HostService">
          <File Id="HostExe" Source="$(var.HostExe)" Name="creamote-host.exe" KeyPath="yes" />
          <ServiceInstall Id="HostServiceInstall"
                          Name="CreamoteHost"
                          DisplayName="Creamote Host"
                          Description="Rend cette machine accessible à distance avec Creamote."
                          Type="ownProcess"
                          Start="auto"
                          ErrorControl="normal"
                          Account="LocalSystem"
                          Arguments="service run" />
          <ServiceControl Id="HostServiceControl"
                          Name="CreamoteHost"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Creamote Host">
      <ComponentRef Id="HostService" />
    </Feature>
  </Package>
</Wix>
