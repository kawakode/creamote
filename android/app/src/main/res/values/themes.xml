<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Creamote" parent="android:Theme.DeviceDefault.Light.DarkActionBar">
        <item name="android:colorAccent">#2F6FDE</item>
    </style>
    <style name="Theme.Creamote.Fullscreen" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#2F6FDE</item>
    </style>
    <style name="Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
    </style>
    <style name="ToolButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">false</item>
    </style>
</resources>
